# Copy this file to .env and adjust the values for your environment:
#   cp .env.example .env
#
# Real environment variables always win over .env files.
# DO NOT DEFINE PRODUCTION SECRETS IN THIS FILE NOR IN ANY OTHER COMMITTED FILES.

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=change-me
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> symfony/routing ###
DEFAULT_URI=http://localhost
###< symfony/routing ###
###> doctrine/doctrine-bundle ###
DATABASE_URL="mysql://app:change-me@127.0.0.1:3306/app?serverVersion=8.4&charset=utf8mb4"
###< doctrine/doctrine-bundle ###

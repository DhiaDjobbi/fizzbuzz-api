# Copy this file to .env and adjust the values for your environment:
#   cp .env.example .env
#
# Real environment variables always win over .env files.
# DO NOT DEFINE PRODUCTION SECRETS IN THIS FILE NOR IN ANY OTHER COMMITTED FILES.

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=change-me
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> symfony/routing ###
DEFAULT_URI=http://localhost
###< symfony/routing ###

###> doctrine/doctrine-bundle ###
DB_NAME=fizzbuzz
DB_USER=fizzbuzz
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me

DATABASE_URL="mysql://${DB_USER}:${DB_PASSWORD}@127.0.0.1:3306/${DB_NAME}?serverVersion=8.4.0&charset=utf8mb4"
###< doctrine/doctrine-bundle ###
